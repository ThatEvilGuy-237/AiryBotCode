<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="evil" value="/mnt/hdd/projects/evil-sdk-data/feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="evil">
      <package pattern="Evil.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
