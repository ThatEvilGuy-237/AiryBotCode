<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="vendor" value="vendor/nuget" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="vendor">
      <package pattern="Evil.Log.Telemetry" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
