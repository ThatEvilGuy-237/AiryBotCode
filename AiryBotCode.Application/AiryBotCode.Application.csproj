<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Discord.Net" Version="3.17.1" />
    <PackageReference Include="dotenv.net" Version="3.2.1" />
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
  <None Update="..\AiryBotCode.Infrastructure\.env">
    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
  </None>
    <ProjectReference Include="..\AiryBotCode.Domain\AiryBotCode.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Services\Database\BotSettings\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Hive\Texts\*.md;Conversation\Texts\*.md" LogicalName="AiryBotCode.Texts.%(Filename).md" />
  </ItemGroup>
</Project>
